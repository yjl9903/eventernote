{
  "name": "@eventernote/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "eventernote": "tsx packages/eventernote/src/cli.ts",
    "format": "prettier --write '**/*.{ts,js,mjs}'",
    "release": "bumpp package.json packages/*/package.json --commit --push --tag",
    "test:ci": "turbo run test:ci",
    "typecheck": "turbo run typecheck",
    "preversion": "turbo run test:ci"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.4",
    "bumpp": "latest",
    "prettier": "^3.9.4",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.5",
    "turbo": "^2.10.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=v24.0.0"
  }
}
